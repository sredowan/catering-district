# Configure these in hPanel under the Node.js application's environment variables.
# Do not commit production values. Hostinger injects PORT automatically.
NODE_ENV="production"

DB_HOST="your-mysql-host"
DB_PORT="3306"
DB_USER="your-mysql-user"
DB_PASSWORD="your-mysql-password"
DB_NAME="your-mysql-database"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET="replace-with-a-stable-random-secret"
BETTER_AUTH_URL="https://cateringdistrict.com.au"
FRONTEND_URL="https://cateringdistrict.com.au"

SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="contact@cateringdistrict.com.au"
SMTP_PASS="your-mailbox-password"
